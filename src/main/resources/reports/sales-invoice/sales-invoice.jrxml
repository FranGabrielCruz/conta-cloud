  <style name="TH" style="Base" isBold="true" forecolor="#FFFFFF" backcolor="#334155" mode="Opaque"/>
  <parameter name="companyName" class="java.lang.String"/><parameter name="companyLegalName" class="java.lang.String"/><parameter name="companyTaxId" class="java.lang.String"/><parameter name="companyAddress" class="java.lang.String"/><parameter name="companyPhone" class="java.lang.String"/><parameter name="companyEmail" class="java.lang.String"/><parameter name="companyLogo" class="java.io.InputStream"/>
  <parameter name="number" class="java.lang.String"/><parameter name="date" class="java.lang.String"/><parameter name="confirmedAt" class="java.lang.String"/><parameter name="customerName" class="java.lang.String"/><parameter name="customerId" class="java.lang.String"/><parameter name="seller" class="java.lang.String"/><parameter name="branch" class="java.lang.String"/><parameter name="currency" class="java.lang.String"/><parameter name="paymentCondition" class="java.lang.String"/><parameter name="notes" class="java.lang.String"/><parameter name="status" class="java.lang.String"/>
  <parameter name="subtotal" class="java.math.BigDecimal"/><parameter name="discount" class="java.math.BigDecimal"/><parameter name="tax" class="java.math.BigDecimal"/><parameter name="total" class="java.math.BigDecimal"/><parameter name="received" class="java.math.BigDecimal"/><parameter name="change" class="java.math.BigDecimal"/>
  <field name="numero" class="java.lang.Integer"/><field name="codigo" class="java.lang.String"/><field name="descripcion" class="java.lang.String"/><field name="unidad" class="java.lang.String"/><field name="cantidad" class="java.math.BigDecimal"/><field name="precioUnitario" class="java.math.BigDecimal"/><field name="impuesto" class="java.math.BigDecimal"/><field name="total" class="java.math.BigDecimal"/>
  <title><band height="175" splitType="Prevent">
    <image onErrorType="Blank"><reportElement x="0" y="0" width="64" height="52"><printWhenExpression><![CDATA[$P{companyLogo} != null]]></printWhenExpression></reportElement><imageExpression><![CDATA[$P{companyLogo}]]></imageExpression></image>
    <textField textAdjust="StretchHeight"><reportElement style="Heading" x="74" y="0" width="285" height="22"/><textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="74" y="24" width="285" height="13"><printWhenExpression><![CDATA[$P{companyLegalName} != null && !$P{companyLegalName}.isBlank()]]></printWhenExpression></reportElement><textFieldExpression><![CDATA[$P{companyLegalName}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="74" y="39" width="285" height="13"><printWhenExpression><![CDATA[$P{companyTaxId} != null]]></printWhenExpression></reportElement><textFieldExpression><![CDATA["RNC / Identificación: "+$P{companyTaxId}]]></textFieldExpression></textField>
    <textField textAdjust="StretchHeight"><reportElement style="Base" x="0" y="58" width="355" height="26"/><textFieldExpression><![CDATA[$P{companyAddress} == null ? "" : $P{companyAddress}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="0" y="85" width="355" height="13"/><textFieldExpression><![CDATA[($P{companyPhone}==null?"":$P{companyPhone}) + ($P{companyEmail}==null?"":"  ·  "+$P{companyEmail})]]></textFieldExpression></textField>
    <staticText><reportElement style="Heading" x="370" y="0" width="165" height="22"/><textElement textAlignment="Right"/><text><![CDATA[FACTURA]]></text></staticText>
    <textField><reportElement style="Heading" x="370" y="25" width="165" height="22"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{number}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="370" y="52" width="165" height="14"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Fecha: "+$P{date}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="370" y="68" width="165" height="14"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Moneda: "+$P{currency}]]></textFieldExpression></textField>
    <staticText><reportElement style="Heading" x="370" y="86" width="165" height="16" forecolor="#B91C1C"><printWhenExpression><![CDATA["VOIDED".equals($P{status})]]></printWhenExpression></reportElement><textElement textAlignment="Right"/><text><![CDATA[ANULADA]]></text></staticText>
    <rectangle radius="5"><reportElement x="0" y="106" width="535" height="64" forecolor="#CBD5E1"/></rectangle>
    <staticText><reportElement style="Section" x="10" y="112" width="245" height="13"/><text><![CDATA[CLIENTE]]></text></staticText>
    <textField><reportElement style="Base" x="10" y="128" width="245" height="14"/><textFieldExpression><![CDATA[$P{customerName}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="10" y="145" width="245" height="14"/><textFieldExpression><![CDATA["Identificación: "+$P{customerId}]]></textFieldExpression></textField>
    <staticText><reportElement style="Section" x="275" y="112" width="250" height="13"/><text><![CDATA[DATOS DE VENTA]]></text></staticText>
    <textField><reportElement style="Base" x="275" y="128" width="250" height="14"/><textFieldExpression><![CDATA["Vendedor: "+$P{seller}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="275" y="145" width="250" height="14"/><textFieldExpression><![CDATA["Sucursal: "+$P{branch}+"  ·  "+$P{paymentCondition}]]></textFieldExpression></textField>
  </band></title>
  <pageHeader><band height="35"><printWhenExpression><![CDATA[$V{PAGE_NUMBER}>1]]></printWhenExpression><textField><reportElement style="Heading" x="0" y="0" width="300" height="20"/><textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression></textField><textField><reportElement style="Heading" x="365" y="0" width="170" height="20"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{number}]]></textFieldExpression></textField></band></pageHeader>
  <columnHeader><band height="24">
    <staticText><reportElement style="TH" x="0" y="0" width="25" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[#]]></text></staticText><staticText><reportElement style="TH" x="25" y="0" width="68" height="24"/><textElement verticalAlignment="Middle"/><text><![CDATA[Código]]></text></staticText><staticText><reportElement style="TH" x="93" y="0" width="175" height="24"/><textElement verticalAlignment="Middle"/><text><![CDATA[Descripción]]></text></staticText><staticText><reportElement style="TH" x="268" y="0" width="52" height="24"/><textElement verticalAlignment="Middle"/><text><![CDATA[Unidad]]></text></staticText><staticText><reportElement style="TH" x="320" y="0" width="55" height="24"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Cant.]]></text></staticText><staticText><reportElement style="TH" x="375" y="0" width="58" height="24"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Precio]]></text></staticText><staticText><reportElement style="TH" x="433" y="0" width="48" height="24"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Imp.]]></text></staticText><staticText><reportElement style="TH" x="481" y="0" width="54" height="24"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Total]]></text></staticText>
  </band></columnHeader>
  <detail><band height="22" splitType="Prevent">
    <textField><reportElement style="Base" x="0" y="2" width="25" height="17"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{numero}]]></textFieldExpression></textField><textField><reportElement style="Base" x="25" y="2" width="68" height="17"/><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField><textField textAdjust="StretchHeight"><reportElement style="Base" x="93" y="2" width="175" height="17"/><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField><textField><reportElement style="Base" x="268" y="2" width="52" height="17"/><textFieldExpression><![CDATA[$F{unidad}]]></textFieldExpression></textField><textField pattern="#,##0.00##"><reportElement style="Base" x="320" y="2" width="55" height="17"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement style="Base" x="375" y="2" width="58" height="17"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{precioUnitario}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement style="Base" x="433" y="2" width="48" height="17"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{impuesto}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement style="Base" x="481" y="2" width="54" height="17"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{total}]]></textFieldExpression></textField><line><reportElement x="0" y="21" width="535" height="1" forecolor="#E2E8F0"/></line>
  </band></detail>
  <pageFooter><band height="18"><textField><reportElement style="Base" x="395" y="2" width="110" height="14"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Página "+$V{PAGE_NUMBER}+" de"]]></textFieldExpression></textField><textField evaluationTime="Report"><reportElement style="Base" x="508" y="2" width="27" height="14"/><textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
  <summary><band height="168" splitType="Prevent">
    <staticText><reportElement style="Section" x="0" y="10" width="300" height="14"><printWhenExpression><![CDATA[$P{notes}!=null && !$P{notes}.isBlank()]]></printWhenExpression></reportElement><text><![CDATA[NOTAS]]></text></staticText><textField textAdjust="StretchHeight"><reportElement style="Base" x="0" y="28" width="305" height="42"><printWhenExpression><![CDATA[$P{notes}!=null && !$P{notes}.isBlank()]]></printWhenExpression></reportElement><textFieldExpression><![CDATA[$P{notes}]]></textFieldExpression></textField>
    <staticText><reportElement style="Section" x="335" y="8" width="95" height="16"/><textElement textAlignment="Right"/><text><![CDATA[Subtotal]]></text></staticText><textField pattern="#,##0.00"><reportElement style="Base" x="435" y="8" width="100" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{subtotal}]]></textFieldExpression></textField>
    <staticText><reportElement style="Section" x="335" y="26" width="95" height="16"><printWhenExpression><![CDATA[$P{discount} != null && $P{discount}.signum() > 0]]></printWhenExpression></reportElement><textElement textAlignment="Right"/><text><![CDATA[Descuento]]></text></staticText><textField pattern="-#,##0.00"><reportElement style="Base" x="435" y="26" width="100" height="16" forecolor="#B91C1C"><printWhenExpression><![CDATA[$P{discount} != null && $P{discount}.signum() > 0]]></printWhenExpression></reportElement><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{discount}]]></textFieldExpression></textField>
    <staticText><reportElement style="Section" x="335" y="44" width="95" height="16"/><textElement textAlignment="Right"/><text><![CDATA[Impuestos]]></text></staticText><textField pattern="#,##0.00"><reportElement style="Base" x="435" y="44" width="100" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{tax}]]></textFieldExpression></textField><line><reportElement x="335" y="64" width="200" height="1" forecolor="#94A3B8"/></line><staticText><reportElement style="Heading" x="335" y="70" width="95" height="22"/><textElement textAlignment="Right"/><text><![CDATA[TOTAL]]></text></staticText><textField pattern="#,##0.00"><reportElement style="Heading" x="435" y="70" width="100" height="22"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{total}]]></textFieldExpression></textField><staticText><reportElement style="Section" x="335" y="96" width="95" height="16"/><textElement textAlignment="Right"/><text><![CDATA[Recibido]]></text></staticText><textField pattern="#,##0.00"><reportElement style="Base" x="435" y="96" width="100" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{received}]]></textFieldExpression></textField><staticText><reportElement style="Section" x="335" y="114" width="95" height="16"/><textElement textAlignment="Right"/><text><![CDATA[Cambio]]></text></staticText><textField pattern="#,##0.00"><reportElement style="Base" x="435" y="114" width="100" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{change}]]></textFieldExpression></textField>
