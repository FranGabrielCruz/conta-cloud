<textField pattern="#,##0.00"><reportElement positionType="Float" x="112" y="20" width="95" height="15"/><textElement textAlignment="Right"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$F{total}]]></textFieldExpression></textField></band></detail>
<summary><band height="120"><textField textAdjust="StretchHeight"><reportElement x="0" y="8" width="207" height="108"/><textElement><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Subtotal: " + new java.text.DecimalFormat("#,##0.00",java.text.DecimalFormatSymbols.getInstance(java.util.Locale.US)).format($P{subtotal}) + "\nDescuento: " + new java.text.DecimalFormat("#,##0.00",java.text.DecimalFormatSymbols.getInstance(java.util.Locale.US)).format($P{discount}) + "\nRecargo: " + new java.text.DecimalFormat("#,##0.00",java.text.DecimalFormatSymbols.getInstance(java.util.Locale.US)).format($P{surcharge}) + "\nImpuestos: " + new java.text.DecimalFormat("#,##0.00",java.text.DecimalFormatSymbols.getInstance(java.util.Locale.US)).format($P{tax}) + "\nTOTAL " + $P{currency} + ": " + new java.text.DecimalFormat("#,##0.00",java.text.DecimalFormatSymbols.getInstance(java.util.Locale.US)).format($P{total}) + "\nRecibido: " + new java.text.DecimalFormat("#,##0.00",java.text.DecimalFormatSymbols.getInstance(java.util.Locale.US)).format($P{received}) + "\nCambio: " + new java.text.DecimalFormat("#,##0.00",java.text.DecimalFormatSymbols.getInstance(java.util.Locale.US)).format($P{change})]]></textFieldExpression></textField></band></summary>
