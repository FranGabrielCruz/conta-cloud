  <parameter name="number" class="java.lang.String"/><parameter name="date" class="java.lang.String"/><parameter name="confirmedAt" class="java.lang.String"/><parameter name="customerName" class="java.lang.String"/><parameter name="customerId" class="java.lang.String"/><parameter name="seller" class="java.lang.String"/><parameter name="branch" class="java.lang.String"/><parameter name="currency" class="java.lang.String"/><parameter name="paymentCondition" class="java.lang.String"/><parameter name="dueDate" class="java.lang.String"/><parameter name="notes" class="java.lang.String"/><parameter name="status" class="java.lang.String"/>
  <parameter name="subtotal" class="java.math.BigDecimal"/><parameter name="discount" class="java.math.BigDecimal"/><parameter name="surcharge" class="java.math.BigDecimal"/><parameter name="tax" class="java.math.BigDecimal"/><parameter name="total" class="java.math.BigDecimal"/><parameter name="received" class="java.math.BigDecimal"/><parameter name="change" class="java.math.BigDecimal"/>
