<title><band height="115" splitType="Stretch">
<textField textAdjust="StretchHeight"><reportElement x="0" y="0" width="207" height="22"/><textElement textAlignment="Center"><font fontName="SansSerif" size="11" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression></textField>
<textField><reportElement x="0" y="25" width="207" height="15"/><textElement textAlignment="Center"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$P{companyTaxId}]]></textFieldExpression></textField>
<textField><reportElement x="0" y="42" width="207" height="15"/><textElement><font fontName="SansSerif" size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Factura: " + $P{number}]]></textFieldExpression></textField>
<textField><reportElement x="0" y="59" width="207" height="15"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$P{confirmedAt}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight"><reportElement x="0" y="76" width="207" height="15"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Cliente: " + $P{customerName}]]></textFieldExpression></textField>
<textField><reportElement x="0" y="96" width="207" height="15"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Condición: " + $P{paymentCondition}]]></textFieldExpression></textField>
</band></title>
<detail><band height="38" splitType="Stretch"><textField textAdjust="StretchHeight"><reportElement x="0" y="0" width="207" height="17"/><textElement><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField>
