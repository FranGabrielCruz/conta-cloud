<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="customer_receipt" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="24" whenNoDataType="AllSectionsNoDetail">
  <style name="Base" fontName="SansSerif" fontSize="9" forecolor="#172033"/>
  <style name="Heading" style="Base" fontSize="16" isBold="true"/>
  <style name="Section" style="Base" fontSize="8" isBold="true" forecolor="#475569"/>
  <parameter name="companyName" class="java.lang.String"/><parameter name="companyLegalName" class="java.lang.String"/><parameter name="companyTaxId" class="java.lang.String"/><parameter name="companyAddress" class="java.lang.String"/><parameter name="companyPhone" class="java.lang.String"/><parameter name="companyEmail" class="java.lang.String"/><parameter name="companyLogo" class="java.io.InputStream"/>
  <parameter name="number" class="java.lang.String"/><parameter name="date" class="java.lang.String"/><parameter name="confirmedAt" class="java.lang.String"/><parameter name="customer" class="java.lang.String"/><parameter name="customerId" class="java.lang.String"/><parameter name="currency" class="java.lang.String"/><parameter name="branch" class="java.lang.String"/><parameter name="status" class="java.lang.String"/><parameter name="reference" class="java.lang.String"/><parameter name="notes" class="java.lang.String"/><parameter name="user" class="java.lang.String"/>
  <parameter name="received" class="java.math.BigDecimal"/><parameter name="applied" class="java.math.BigDecimal"/><parameter name="available" class="java.math.BigDecimal"/><parameter name="applications" class="java.lang.String"/><parameter name="methods" class="java.lang.String"/>
  <title><band height="620" splitType="Stretch">
    <image onErrorType="Blank"><reportElement x="0" y="0" width="64" height="52"><printWhenExpression><![CDATA[$P{companyLogo} != null]]></printWhenExpression></reportElement><imageExpression><![CDATA[$P{companyLogo}]]></imageExpression></image>
    <textField><reportElement style="Heading" x="74" y="0" width="280" height="22"/><textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="74" y="25" width="280" height="14"/><textFieldExpression><![CDATA[$P{companyLegalName}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="74" y="42" width="280" height="14"/><textFieldExpression><![CDATA["RNC / Identificación: "+$P{companyTaxId}]]></textFieldExpression></textField>
    <staticText><reportElement style="Heading" x="365" y="0" width="170" height="22"/><textElement textAlignment="Right"/><text><![CDATA[RECIBO DE COBRO]]></text></staticText>
    <textField><reportElement style="Heading" x="365" y="27" width="170" height="22"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{number}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="365" y="53" width="170" height="14"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Fecha: "+$P{date}]]></textFieldExpression></textField>
    <staticText><reportElement style="Heading" x="365" y="72" width="170" height="18" forecolor="#B91C1C"><printWhenExpression><![CDATA["VOIDED".equals($P{status})]]></printWhenExpression></reportElement><textElement textAlignment="Right"/><text><![CDATA[ANULADO]]></text></staticText>
    <textField textAdjust="StretchHeight"><reportElement style="Base" x="0" y="72" width="350" height="28"/><textFieldExpression><![CDATA[($P{companyAddress}==null?"":$P{companyAddress})+"\n"+($P{companyPhone}==null?"":$P{companyPhone})+($P{companyEmail}==null?"":" · "+$P{companyEmail})]]></textFieldExpression></textField>
    <rectangle radius="5"><reportElement x="0" y="112" width="535" height="75" forecolor="#CBD5E1"/></rectangle>
    <staticText><reportElement style="Section" x="12" y="120" width="240" height="13"/><text><![CDATA[CLIENTE]]></text></staticText>
    <textField><reportElement style="Base" x="12" y="138" width="240" height="15"/><textFieldExpression><![CDATA[$P{customer}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="12" y="157" width="240" height="15"/><textFieldExpression><![CDATA["Identificación: "+$P{customerId}]]></textFieldExpression></textField>
    <staticText><reportElement style="Section" x="275" y="120" width="245" height="13"/><text><![CDATA[DATOS DEL RECIBO]]></text></staticText>
    <textField><reportElement style="Base" x="275" y="138" width="245" height="15"/><textFieldExpression><![CDATA["Moneda: "+$P{currency}+" · Ref.: "+$P{reference}]]></textFieldExpression></textField>
    <textField><reportElement style="Base" x="275" y="157" width="245" height="15"/><textFieldExpression><![CDATA["Sucursal: "+$P{branch}+" · "+$P{user}]]></textFieldExpression></textField>
    <staticText><reportElement style="Section" x="0" y="205" width="535" height="16"/><text><![CDATA[FACTURAS APLICADAS]]></text></staticText>
    <textField textAdjust="StretchHeight"><reportElement style="Base" x="0" y="226" width="535" height="85" backcolor="#F8FAFC" mode="Opaque"/><textFieldExpression><![CDATA[$P{applications}]]></textFieldExpression></textField>
    <staticText><reportElement positionType="Float" style="Section" x="0" y="330" width="535" height="16"/><text><![CDATA[MEDIOS DE PAGO]]></text></staticText>
    <textField textAdjust="StretchHeight"><reportElement positionType="Float" style="Base" x="0" y="351" width="535" height="85" backcolor="#F8FAFC" mode="Opaque"/><textFieldExpression><![CDATA[$P{methods}]]></textFieldExpression></textField>
    <staticText><reportElement positionType="Float" style="Section" x="330" y="464" width="105" height="16"/><textElement textAlignment="Right"/><text><![CDATA[RECIBIDO]]></text></staticText><textField pattern="#,##0.00"><reportElement positionType="Float" style="Base" x="440" y="464" width="95" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{received}]]></textFieldExpression></textField>
    <staticText><reportElement positionType="Float" style="Section" x="330" y="485" width="105" height="16"/><textElement textAlignment="Right"/><text><![CDATA[APLICADO]]></text></staticText><textField pattern="#,##0.00"><reportElement positionType="Float" style="Base" x="440" y="485" width="95" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{applied}]]></textFieldExpression></textField>
    <line><reportElement positionType="Float" x="330" y="507" width="205" height="1" forecolor="#94A3B8"/></line>
    <staticText><reportElement positionType="Float" style="Heading" x="330" y="514" width="105" height="22"/><textElement textAlignment="Right"/><text><![CDATA[DISPONIBLE]]></text></staticText><textField pattern="#,##0.00"><reportElement positionType="Float" style="Heading" x="440" y="514" width="95" height="22"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$P{available}]]></textFieldExpression></textField>
    <staticText><reportElement positionType="Float" style="Section" x="0" y="552" width="280" height="14"/><text><![CDATA[OBSERVACIÓN]]></text></staticText><textField textAdjust="StretchHeight"><reportElement positionType="Float" style="Base" x="0" y="570" width="300" height="36"/><textFieldExpression><![CDATA[$P{notes}]]></textFieldExpression></textField>
    <textField><reportElement positionType="Float" style="Base" x="320" y="570" width="215" height="16"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Confirmado: "+$P{confirmedAt}]]></textFieldExpression></textField>
  </band></title>
  <pageFooter><band height="18"><textField><reportElement style="Base" x="395" y="2" width="140" height="14"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Página "+$V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
</jasperReport>
