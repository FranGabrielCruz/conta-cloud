    <textField textAdjust="StretchHeight"><reportElement style="Base" x="72" y="42" width="250" height="26"><printWhenExpression><![CDATA[$P{companyAddress} != null && !$P{companyAddress}.isBlank()]]></printWhenExpression></reportElement><textFieldExpression><![CDATA[$P{companyAddress}]]></textFieldExpression></textField>
